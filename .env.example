# Remote backend is disabled by default so this template cannot connect to
# any real database by accident.
VITE_ENABLE_LOCAL_BACKEND=false
VITE_ENABLE_REMOTE_BACKEND=false

# Local Supabase uses http://127.0.0.1:54321 and the local publishable/anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fill this only for a brand-new hosted Supabase project.
VITE_SUPABASE_PROJECT_REF=

# Public URL for the new marketplace deployment.
VITE_PUBLIC_SITE_URL=http://localhost:5173
