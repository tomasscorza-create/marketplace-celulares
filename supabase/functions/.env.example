# Copy these names into the Supabase dashboard or local function secrets for a
# brand-new project only. Never use credentials from the sold/original project.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APP_BASE_URL=http://localhost:5173
WEBHOOK_BASE_URL=http://127.0.0.1:54321/functions/v1

MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_TEST_WEBHOOK_SECRET=

# Production values are only for a real new deployment, after checkout is tested.
MERCADOPAGO_PRODUCTION_ACCESS_TOKEN=
MERCADOPAGO_PRODUCTION_WEBHOOK_SECRET=

MERCADOPAGO_STATEMENT_DESCRIPTOR=MARKETPLACE
PENDING_CHECKOUTS_CRON_SECRET=
