{
  "name": "neutral-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build --config vite.config.ts && npm run audit:pwa",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run build",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:stop": "supabase stop",
    "audit:secrets": "node scripts/audit-safety.mjs secrets",
    "audit:connections": "node scripts/audit-safety.mjs connections",
    "audit:branding": "node scripts/audit-safety.mjs branding",
    "audit:backend": "node scripts/audit-backend-symbols.mjs",
    "docs:backend-map": "node scripts/audit-backend-symbols.mjs --write-map",
    "audit:encoding": "node scripts/audit-encoding.mjs",
    "audit:large-files": "node scripts/audit-large-files.mjs 1000 --check",
    "audit:pwa": "node scripts/audit-pwa-precache.mjs",
    "audit:safety": "node scripts/audit-safety.mjs all",
    "safety:quarantine": "node scripts/quarantine-local-secrets.mjs",
    "preflight": "npm run lint && npm run typecheck && npm run test && npm run audit:backend && npm run audit:secrets && npm run audit:connections && npm run audit:encoding && npm run audit:large-files"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.99.0",
    "html-to-image": "^1.11.13",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
